      "id": "OBJ-FSCA-MANDATE",
      "nodeType": "RegulatoryObjective",
      "label": "Objective of the Financial Sector Conduct Authority",
      "objectiveText": "The objective of the Financial Sector Conduct Authority is to (a) protect financial customers by promoting the fair treatment of financial customers by financial institutions, and by providing financial customers and potential financial customers with financial education programmes and otherwise promoting financial literacy and the ability of financial customers and potential financial customers to make sound financial decisions; (b) enhance and support the efficiency and integrity of the financial system; and to (c) assist in maintaining financial stability.",
      "objectiveLevel": "mandate",
      "sourceCitation": "urn:reg:za:fsr-act-9-2017:s.57"
    },
    {
      "id": "OBJ-FSCA-FAIR-TREATMENT",
      "nodeType": "RegulatoryObjective",
      "label": "Fair treatment of financial customers (TCF)",
      "objectiveText": "Protect financial customers by promoting the fair treatment of financial customers by financial institutions — the Treating Customers Fairly (TCF) outcomes embedded across the product and service lifecycle.",
      "objectiveLevel": "objective",
      "sourceCitation": "urn:reg:za:fsr-act-9-2017:s.57(a)"
    },
