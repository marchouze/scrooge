{
  "name": "bank-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "bunx tsc --noEmit",
    "ci": "bun run typecheck && bun run lint && bun test && bun run citation-gate && bun run recon && bun run recon:dashboard && bun run recon:prose-duplication",
    "scenario:hello": "bun run scenarios/01-hello-bank.ts",
    "scenario:onboard": "bun run scenarios/02-onboard-counterparty.ts",
    "citation-gate": "bun run platform/citation/gate.ts",
    "recon": "bun run platform/recon/harness.ts",
    "recon:mandate": "bun run platform/recon/mandate-ownership.ts",
    "recon:decisions": "bun run platform/recon/decision-event-recon.ts",
    "recon:dashboard": "bun run platform/recon/dashboard-derivation-recon.ts",
    "recon:prose-duplication": "bun run platform/recon/prose-duplication.ts",
    "dashboard": "bun run dashboard/server.ts",
    "agent:run": "bun run runtime/run.ts",
    "agent:vera-overnight": "bun run runtime/run.ts --agent Vera --trigger overnight-recon",
    "agent:atlas-substrate-state": "bun run runtime/run.ts --agent Atlas --trigger substrate-state",
    "reset": "rm -rf .local && mkdir -p .local"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  }
}
