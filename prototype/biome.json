{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "files": {
    "ignore": [
      ".local/**",
      "node_modules/**",
      "v2-core/regulatory-returns/ba100-contract.json",
      "v2-core/regulatory-returns/ba110-contract.json",
      "v2-core/regulatory-returns/ba120-contract.json",
      "v2-core/regulatory-returns/ba200-contract.json",
      "v2-core/regulatory-returns/ba210-contract.json",
      "v2-core/regulatory-returns/ba220-contract.json",
      "v2-core/regulatory-returns/ba300-contract.json",
      "v2-core/regulatory-returns/ba310-contract.json",
      "v2-core/regulatory-returns/ba320-contract.json",
      "v2-core/regulatory-returns/ba325-contract.json",
      "v2-core/regulatory-returns/ba330-contract.json",
      "v2-core/regulatory-returns/ba340-contract.json",
      "v2-core/regulatory-returns/ba350-contract.json",
      "v2-core/regulatory-returns/ba400-contract.json",
      "v2-core/regulatory-returns/ba410-contract.json",
      "v2-core/regulatory-returns/ba420-contract.json",
      "v2-core/regulatory-returns/ba500-contract.json",
      "v2-core/regulatory-returns/ba501-contract.json",
      "v2-core/regulatory-returns/ba125-contract.json",
      "v2-core/regulatory-returns/ba130-contract.json",
      "v2-core/regulatory-returns/ba600-contract.json",
      "v2-core/regulatory-returns/ba610-contract.json",
      "v2-core/regulatory-returns/ba700-contract.json",
      "v2-core/regulatory-returns/ba701-contract.json"
    ]
  },
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "error",
        "useConst": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "correctness": {
        "noUnusedVariables": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  }
}
