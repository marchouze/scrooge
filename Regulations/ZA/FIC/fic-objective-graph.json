      "id": "OBJ-FIC-MANDATE",
      "nodeType": "RegulatoryObjective",
      "label": "Objectives of the Financial Intelligence Centre",
      "objectiveText": "The principal objective of the Financial Intelligence Centre is to assist in the identification of the proceeds of unlawful activities and the combating of money laundering activities, the financing of terrorist and related activities (terrorist financing) and proliferation financing; to make information collected by it available to investigating authorities, supervisory bodies, the South African Revenue Service, the intelligence services and the National Prosecuting Authority to facilitate the administration and enforcement of the laws of the Republic; to exchange information with similar bodies in other countries; and to supervise and enforce compliance with the Act.",
      "objectiveLevel": "mandate",
      "sourceCitation": "urn:reg:za:fic-act-38-2001:s.3"
    },
    {
      "id": "OBJ-FIC-FINANCIAL-INTELLIGENCE",
      "nodeType": "RegulatoryObjective",
      "label": "Generation of financial intelligence for investigating authorities",
      "objectiveText": "Collect, analyse and disseminate financial intelligence — the cash-threshold, terrorist-property and suspicious-and-unusual-transaction reports submitted by accountable institutions — to investigating authorities, supervisory bodies and prosecuting authorities to identify the proceeds of unlawful activity and disrupt money laundering, terrorist financing and proliferation financing.",
      "objectiveLevel": "objective",
      "sourceCitation": "urn:reg:za:fic-act-38-2001:s.3"
    },
    {
      "id": "OBJ-FIC-CDD-INTEGRITY",
      "nodeType": "RegulatoryObjective",
      "label": "Customer due diligence and identity integrity",
      "objectiveText": "Ensure accountable institutions know who their clients and beneficial owners are through risk-based customer due diligence, enhanced due diligence for higher-risk clients, beneficial-ownership transparency, record-keeping and ongoing monitoring — preventing the financial system from being used to launder the proceeds of crime or finance terrorism.",
      "objectiveLevel": "objective",
      "sourceCitation": "urn:reg:za:fic-act-38-2001:s.3"
    },
    {
      "id": "OBJ-FIC-TARGETED-SANCTIONS",
      "nodeType": "RegulatoryObjective",
      "label": "Implementation of targeted financial sanctions",
      "objectiveText": "Ensure accountable institutions implement targeted financial sanctions without delay — screening clients and transactions against the UN Security Council and s.26A targeted-financial-sanctions lists, freezing the property of designated persons and entities, and reporting terrorist property to the Centre — to combat terrorist financing and proliferation financing.",
      "objectiveLevel": "objective",
      "sourceCitation": "urn:reg:za:fic-act-38-2001:s.3"
    },
    {
      "id": "OBJ-FIC-AML-SUPERVISION",
      "nodeType": "RegulatoryObjective",
      "label": "AML/CFT supervision, governance and compliance culture",
      "objectiveText": "Ensure accountable institutions maintain an approved Risk Management and Compliance Programme, appoint a compliance officer / Money Laundering Reporting Officer with sufficient seniority and independence, hold the board and senior management accountable for AML/CFT compliance, and train staff — supervised and enforced by the Centre and the designated supervisory bodies.",
      "objectiveLevel": "objective",
      "sourceCitation": "urn:reg:za:fic-act-38-2001:s.3"
    }
