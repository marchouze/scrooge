{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank.local/schema/chart-of-accounts/v0.1",
  "title": "Chart-of-accounts entry",
  "description": "Typed object form of a single general-ledger account in Bea's chart of accounts (per Team/Bea.md §11 — owned with Atlas). The chart is the canonical mapping from event flows to GL accounts; every PostingRulePublished event references account IDs from this register.",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "side",
    "ifrsClassification",
    "currencies",
    "entityScope",
    "version",
    "status",
    "citations"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ACC-[0-9]{4}-[0-9]{3}$",
      "description": "Stable GL account identifier. Convention: ACC-<TYPE><CATEGORY>-<NNN>. The four-digit prefix encodes the IFRS classification group (e.g., 1xxx assets, 2xxx liabilities, 3xxx equity, 4xxx income, 5xxx expense)."
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "asset-cash",
        "asset-cash-equivalents",
        "asset-investment",
        "asset-loan",
        "asset-derivative",
        "asset-receivable",
        "asset-trading",
        "asset-suspense",
        "asset-other",
        "liability-deposit",
        "liability-funding",
        "liability-derivative",
        "liability-payable",
        "liability-suspense",
        "liability-trading",
        "liability-other",
        "equity",
        "income-interest",
        "income-fee",
        "income-trading",
        "income-other",
        "expense-interest",
        "expense-operating",
        "expense-impairment",
        "expense-tax",
        "ocl"
      ]
    },
    "side": {
      "type": "string",
      "enum": ["debit", "credit"],
      "description": "Natural balance side. A debit-natural account increases on debit postings."
    },
    "ifrsClassification": {
      "type": "string",
      "enum": [
        "amortised-cost",
        "fvoci-debt",
        "fvoci-equity",
        "fvtpl",
        "non-financial",
        "equity",
        "n-a"
      ],
      "description": "IFRS 9 classification (where applicable). Non-financial-instrument accounts use 'non-financial'."
    },
    "currencies": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Z]{3}$" },
      "description": "ISO 4217 currencies in which this account holds balances. Per Principle 5, every account declares its currencies; no implicit default currency."
    },
    "entityScope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^LE-[A-Z]{2}-[A-Z0-9]{3,12}$" },
      "description": "Legal-entity IDs for which this account exists. References the legal-entity tree."
    },
    "baReturnLines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["form", "line", "side"],
        "additionalProperties": false,
        "properties": {
          "form": {
            "type": "string",
            "pattern": "^BA[ ]?[0-9]{3}$",
            "description": "BA-return form, e.g. 'BA 100', 'BA 200', 'BA 300', 'BA 700'."
          },
          "line": { "type": "string", "description": "Line / cell identifier within the form." },
          "side": { "type": "string", "enum": ["positive", "negative", "memo"] },
          "note": { "type": "string" }
        }
      },
      "default": [],
      "description": "BA-return cell mappings this account contributes to. Aggregation logic is canonical in the BA-return generator; the mapping declared here is the single source of truth."
    },
    "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+$" },
    "status": { "type": "string", "enum": ["draft", "in-force", "deprecated"] },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "oneOf": [
          {
            "required": ["type", "regulationId"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "regulation" },
              "regulationId": { "type": "string", "pattern": "^ORG-[A-Z0-9]+-[0-9]+$" },
              "note": { "type": "string" }
            }
          },
          {
            "required": ["type", "policyRef"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "policy" },
              "policyRef": { "type": "string" },
              "section": { "type": "string" },
              "note": { "type": "string" }
            }
          },
          {
            "required": ["type", "ifrsRef"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "ifrs" },
              "ifrsRef": {
                "type": "string",
                "description": "IFRS / IAS reference, e.g. 'IFRS 9 §4.1.2'."
              },
              "note": { "type": "string" }
            }
          },
          {
            "required": ["type", "statuteRef"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "statute" },
              "statuteRef": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        ]
      }
    }
  }
}
