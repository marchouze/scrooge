      "label": "Efficiency and integrity of the financial system",
      "objectiveText": "Enhance and support the efficiency and integrity of the financial system, including fair and orderly financial markets and the prevention of market abuse.",
      "objectiveLevel": "objective",
      "sourceCitation": "urn:reg:za:fsr-act-9-2017:s.57(b)"
    },
    {
      "id": "OBJ-FSCA-FINANCIAL-INCLUSION",
      "nodeType": "RegulatoryObjective",
      "label": "Financial inclusion",
      "objectiveText": "Promote financial inclusion — supporting access to appropriate financial products and services for financial customers and potential financial customers.",
      "objectiveLevel": "objective",
      "sourceCitation": "urn:reg:za:fsr-act-9-2017:s.57(a)"
    },
